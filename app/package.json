{
  "name": "home-assistant-webhook-converter",
  "version": "1.0.0",
  "description": "Convert GET requests to POST for Home Assistant webhooks - Enables NFC tags, browsers, and GET-only services to trigger Home Assistant automations",
  "main": "server.js",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "webhook",
    "converter",
    "get-to-post",
    "nfc",
    "automation",
    "synology",
    "docker",
    "nodejs",
    "express",
    "webhook-proxy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-USERNAME/home-assistant-webhook-converter.git"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,json,html,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,md,yml,yaml}\""
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
